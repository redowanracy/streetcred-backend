# Copy with `npm run setup:env` (generates JWT_SECRET for you). Never commit .env.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# At least 32 random bytes. Keep stable: changing it logs every player out.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90

# PostgreSQL + PostGIS. docker-compose.yml publishes it on 127.0.0.1:5442.
DATABASE_URL=postgres://streetcred:CHANGE_ME@127.0.0.1:5442/streetcred
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX=20

# Comma-separated browser origins allowed by CORS. Empty = no browser access
# (the Unity client is not a browser and does not need CORS).
CORS_ORIGINS=

# Set to 1 when running behind exactly one reverse proxy / load balancer.
TRUST_PROXY=0

# Development-only shortcuts. Always ignored when NODE_ENV=production.
ENABLE_DEV_MONETIZATION=false
# Prints password-reset links to the log instead of emailing them.
DEV_LOG_PASSWORD_RESET_LINKS=true
PASSWORD_RESET_URL_BASE=https://example.invalid/reset-password
